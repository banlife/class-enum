{
  "name": "class-enum",
  "version": "0.1.1",
  "description": "Extendable class-enum on typescript",
  "main": "dist/index.js",
  "scripts": {
    "test": "jest",
    "compile": "tsc",
    "clean": "rm -rf ./dist ./types",
    "build": "npm run clean && npm run test && npm run compile",
    "build:example": "rm -rf ./example/dist && tsc --project ./example",
    "example:defineEnum": "npm run build:example && node example/dist/example/src/defineEnum.js",
    "example:equals": "npm run build:example && node example/dist/example/src/equals.js",
    "example:extension": "npm run build:example && node example/dist/example/src/extension.js",
    "example:name": "npm run build:example && node example/dist/example/src/name.js",
    "example:valueOf": "npm run build:example && node example/dist/example/src/valueOf.js",
    "example:values": "npm run build:example && node example/dist/example/src/values.js"
  },
  "homepage": "https://github.com/banlife/class-enum.git",
  "keywords": [
    "enum",
    "class",
    "typescript"
  ],
  "types": "types/index.d.ts",
  "files": [
    "dist",
    "types",
    "README-KR.md",
    "README.md"
  ],
  "author": "banlife <developer@ban-life.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/banlife/class-enum.git"
  },
  "devDependencies": {
    "@babel/cli": "^7.17.6",
    "@babel/core": "^7.17.9",
    "@babel/plugin-proposal-decorators": "^7.17.9",
    "@babel/preset-env": "^7.16.11",
    "@babel/preset-typescript": "^7.16.7",
    "@types/jest": "^27.5.1",
    "@typescript-eslint/eslint-plugin": "^5.23.0",
    "@typescript-eslint/parser": "^5.23.0",
    "eslint": "^8.15.0",
    "eslint-config-prettier": "^8.5.0",
    "jest": "^28.1.0",
    "prettier": "^2.6.2",
    "typescript": "4.4"
  }
}
